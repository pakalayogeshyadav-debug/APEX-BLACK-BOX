# ==============================================================================
# APEX BLACKBOX - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# --- DATABASE CONFIGURATION ---
# Option A: Full Connection URI (Recommended for Cloud: Render, Aiven, PlanetScale)
# Supports both mysql:// and mysql+aiomysql:// schemes
DATABASE_URL=mysql+aiomysql://db_user:db_password@db_host:3306/apex_blackbox

# Option B: Individual Parameters (Local development fallback)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=apex_blackbox
DB_HOST=localhost
DB_PORT=3306

# --- SECURITY & AUTHENTICATION ---
API_KEY=your_esp32_api_secret_key

# --- CORS SETTINGS ---
# Set to your Vercel frontend URL in production (or comma-separated URLs). Use * for open access.
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# --- HARDWARE & SERIAL INGESTION ---
# Set to false for cloud deployments (Render, Heroku, AWS) where no local COM/serial ports exist.
# Set to true for local gateway execution connected to physical ESP32 via USB.
ENABLE_SERIAL_INGESTION=false

# --- HARDWARE SIMULATOR BRIDGE ---
# IP/hostname of physical ESP32 vehicle simulator on local Wi-Fi network (if applicable)
SIMULATOR_ESP32_BASE_URL=http://192.168.1.100

# ==============================================================================
# FRONTEND CONFIGURATION (Vite - prefixed with VITE_)
# Set these in your Vercel project environment settings:
# ==============================================================================
# Public URL of your deployed FastAPI backend (no trailing slash):
VITE_API_BASE_URL=https://your-backend.onrender.com
# Optional: WebSocket URL override (if not specified, auto-derived from VITE_API_BASE_URL):
# VITE_WS_URL=wss://your-backend.onrender.com/api/v1/ws/telemetry

